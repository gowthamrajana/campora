<% layout('layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/register.css">

<div class="login-page">

    <div class="login-card">

        <img src="https://images.unsplash.com/photo-1571863533956-01c88e79957e?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1267&q=80"
            class="login-img" />

        <div class="card-body">

            <h5 class="login-title">Register</h5>

            <form action="/register" method="POST" class="validated-form" novalidate>

                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <input class="form-control input-modern" type="text" id="username" name="username" required autofocus>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="email">Email</label>
                    <input class="form-control input-modern" type="email" id="email" name="email" required>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-control input-modern" type="password" id="password" name="password" required>
                </div>

                <button class="btn login-btn w-100">
                    Register
                </button>
              </button>

              <div class="mt-3 text-center">
                  <p class="text-muted small">
                      Already have an account? 
                      <a href="/login" class="text-decoration-none" style="font-weight: 600; color: #4b5563;">Login here</a>
                  </p>
              </div>

            </form>

        </div>

    </div>

</div>