<% layout('layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/new.css">

<div class="new-camp-page">

<div class="row">
    <h1 class="text-center">New Campground</h1>

    <div class="new-wrapper col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3">

        <form action="/campgrounds" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label" for="title" >Title</label>
                <input class="form-control" type="text" id="title" name="campground[title]" placeholder="Enter title" required>
            </div>

            <div class="mb-3">
                <label class="form-label" for="location">Enter Location</label>
                <input class="form-control" type="text" id="location" name="campground[location]" placeholder="Enter location" required>
            </div>

            <div class="mb-3">
                <label class="form-label" for="price">Campground Price</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="text" class="form-control" id="price" name="campground[price]" placeholder="Enter price (e.g. 500)" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="description">Description</label>
                <textarea class="form-control" id="description" name="campground[description]" placeholder="Write something about this campground..." required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" for="image">Select one or more images to upload</label>
                <input type="file" class="form-control" id="image" name="image" multiple>
                
            </div>

            <button class="btn btn-success w-100">
                Add Campground
            </button>

        </form>

        

    </div>
</div>

</div>