<% layout('layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/edit.css">
    <div class="row">
      <h1 class="text-center">Edit Campground</h1>
      <div class="col-6 offset-3">
        <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">
          <div class="mb-3">
              <label class="form-label" for="title">Title</label>
              <input class="form-control" type="text" id="title" name="campground[title]" value="<%= campground.title %>"required>
              <div class="valid-feedback">
                looks good!
              </div>
          </div>
          <div class="mb-3">
              <label class="form-label" for="location">Location</label>
              <input class="form-control" type="text" id="location" name="campground[location]" value="<%= campground.location %>"required>
              <div class="valid-feedback">
                looks good!
              </div>
          </div>
          
        <div class="mb-3">
          <label class="form-label" for="price">Campground price</label>
        <div class="input-group">
          <span class="input-group-text" id="price-label">₹</span>
          <input type="text" class="form-control" id="price" placeholder="0.00" aria-label="price" aria-describedby="price-label" name="campground[price]"  value="<%= campground.price%>"required >
          <div class="valid-feedback">
                looks good!
              </div>
        </div>
      </div>

        <div class="mb-3">
          <label class="form-label" for="ddescription">Description</label>
          <textarea class="form-control" type="text" id="description" name="campground[description]" required><%= campground.description %></textarea><div class="valid-feedback">
                looks good!
              </div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="image">Campground Images</label>
        <input
            type="file"
            class="form-control"
            id="image"
            name="image"
            multiple
        >
        <div class="form-text">
            Select one or more images to Add.
        </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Manage Images</label>
      <div class="row row-cols-1 row-cols-md-3 g-3">
          <% campground.images.forEach(function(img, i) { %>
              <div class="col">
                  <div class="card border-0 shadow-sm h-100">
                      <img src="<%= img.thumbnail %>" class="card-img-top" alt="Campground image">
                      <div class="card-body p-2 d-flex justify-content-center">
                          <div class="form-check form-switch">
                              <input class="form-check-input" type="checkbox" id="image-<%= i %>" name="deleteImages[]" value="<%= img.filename %>">
                              <label class="form-check-label small" for="image-<%= i %>">Delete Image</label>
                          </div>
                      </div>
                  </div>
              </div>
          <% }) %>
      </div>
  </div>
  <div class="mb-4 mt-3">
    <div class="d-grid gap-2">
        <button class="btn btn-info btn-lg">Update Campground</button>
    </div>
    
    <div class="text-center mt-3">
        <a href="/campgrounds/<%= campground._id %>" class="text-muted small">
            <i class="fas fa-arrow-left"></i> Cancel and return to campground
        </a>
    </div>
</div>

